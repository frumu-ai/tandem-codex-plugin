# Where the local Tandem engine listens.
# Default Tandem engine port for headless serve mode.
TANDEM_BASE_URL=http://127.0.0.1:39731

# Engine token. The plugin/SDK resolve auth in this order:
#   1) TANDEM_API_TOKEN (below)
#   2) TANDEM_API_TOKEN_FILE
#   3) SDK `token` constructor option (used by scripts/ after loading .env)
# DO NOT commit a real token. Run /tandem-setup in Codex to discover where
# your installer wrote the token. See shared/tandem-auth.md for full recipe.
TANDEM_API_TOKEN=

# Optional: path to a file containing the engine token. Path is whatever
# your installer chose (panel/headless) — the plugin does not assume one.
# Useful with the OS keychain, sealed-secrets, or panel-managed tokens.
# TANDEM_API_TOKEN_FILE=

# Optional dev escape hatch — only for trusted local dev. Do NOT use on
# anything public, hosted, or shared. The engine will warn if this is set.
# TANDEM_UNSAFE_NO_API_TOKEN=1
